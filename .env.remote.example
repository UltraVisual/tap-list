# Copy to .env.remote and fill in your values.
# Usage: source .env.remote && npm run dev:remote

# Your CloudFront distribution domain (for image proxying)
export CLOUDFRONT_DOMAIN=d1du9vme1u38sx.cloudfront.net

# AWS region where your stack is deployed
export AWS_REGION=eu-west-2

# S3 bucket name (from CDK output UploadsBucketName)
export UPLOADS_BUCKET=your-bucket-name-here
