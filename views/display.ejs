<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.taproom_name %> - Tap List</title>
  <link rel="stylesheet" href="/public/css/display.css?v=<%= Date.now() %>">
  <% const themeMap = {
    dark:       { bg: '#111',    cardBg: '#1a1a1a', cardBorder: '#2a2a2a', text: '#f0f0f0', textMuted: '#999',    accent: '#f5a623' },
    light:      { bg: '#f5f2eb', cardBg: '#ffffff', cardBorder: '#e0ddd6', text: '#2c2c2c', textMuted: '#777',    accent: '#c8802a' },
    chalkboard: { bg: '#2b3a2e', cardBg: '#354539', cardBorder: '#445544', text: '#e8e4d8', textMuted: '#a0a89a', accent: '#d4a843' },
    copper:     { bg: '#1c1210', cardBg: '#2a1e1a', cardBorder: '#3d2e28', text: '#f0e0d0', textMuted: '#b09080', accent: '#cd7f32' },
    neon:       { bg: '#0a0a14', cardBg: '#12121f', cardBorder: '#1e1e30', text: '#e0e0ff', textMuted: '#8888bb', accent: '#00e5ff' }
  };
  const t = themeMap[settings.theme] || themeMap.dark;
  %>
  <style>
    :root {
      --bg: <%= t.bg %>;
      --card-bg: <%= t.cardBg %>;
      --card-border: <%= t.cardBorder %>;
      --text: <%= t.text %>;
      --text-muted: <%= t.textMuted %>;
      --accent: <%= t.accent %>;
    }
  </style>
</head>
<body>
  <header class="header">
    <% if (settings.logo_path) { %>
      <img src="<%= settings.logo_path %>" alt="<%= settings.taproom_name %>" class="logo">
    <% } else { %>
      <h1 class="taproom-name"><%= settings.taproom_name %></h1>
    <% } %>
    <button class="pour-drawer-btn" id="pourDrawerBtn" title="Pour tracker">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 3h11l2 9H5z"/>
        <path d="M16 7h3a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2h-2"/>
        <path d="M5 12v9h11v-9"/>
      </svg>
    </button>
    <button class="fullscreen-btn" id="fullscreenBtn" title="Toggle fullscreen">
      <svg class="fullscreen-icon fullscreen-icon--enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
      </svg>
      <svg class="fullscreen-icon fullscreen-icon--exit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
      </svg>
    </button>
  </header>

  <main class="tap-grid">
    <% if (beers.length === 0) { %>
      <div class="empty-state">
        <p>No beers on tap right now.</p>
        <p class="subtle">Head to <a href="/admin">/admin</a> to add some.</p>
      </div>
    <% } %>
    <% beers.forEach(beer => { %>
      <div class="tap-card<%= beer.is_coming_soon ? ' is-coming-soon' : (beer.pints_total > 0 && beer.pints_remaining <= 0) ? ' is-empty' : '' %>" data-beer-id="<%= beer.id %>">
        <div class="tap-number">#<%= beer.tap_number %></div>
        <% if (beer.is_coming_soon) { %>
          <div class="coming-soon-ribbon">COMING SOON</div>
        <% } %>

        <% if (beer.image_path) { %>
          <div class="beer-image">
            <img src="<%= beer.image_path %>" alt="<%= beer.name %>">
          </div>
        <% } else { %>
          <div class="beer-image beer-image--placeholder">
            <svg viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
              <rect width="120" height="80" fill="none"/>
              <text x="60" y="44" text-anchor="middle" fill="rgba(255,255,255,0.15)" font-size="12">No Image</text>
            </svg>
          </div>
        <% } %>

        <div class="beer-info">
          <h2 class="beer-name"><%= beer.name %></h2>
          <% if (beer.style) { %>
            <span class="beer-style"><%= beer.style %></span>
          <% } %>
          <% if (beer.brewery) { %>
            <span class="beer-brewery"><%= beer.brewery %></span>
          <% } %>
          <% if (beer.description) { %>
            <p class="beer-description"><%= beer.description %></p>
          <% } %>
        </div>

        <div class="beer-meta">
          <% if (beer.is_coming_soon) { %>
            <span class="beer-abv"><%= beer.abv.toFixed(1) %>% ABV</span>
            <span class="coming-soon-label">Fermenting</span>
          <% } else { %>
            <span class="beer-abv"><%= beer.abv.toFixed(1) %>% ABV</span>
            <% if (beer.pints_total > 0) { %>
              <div class="pints-indicator" title="<%= Math.round(beer.pints_remaining) %> of <%= beer.pints_total %> pints remaining">
                <div class="pints-bar">
                  <div class="pints-fill" style="width: <%= Math.round((beer.pints_remaining / beer.pints_total) * 100) %>%"></div>
                </div>
                <span class="pints-count"><%= Math.round(beer.pints_remaining) %> pints</span>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>
    <% }) %>
  </main>

  <div class="pour-drawer-overlay" id="pourDrawerOverlay"></div>
  <aside class="pour-drawer" id="pourDrawer" aria-label="Pour tracker">
    <div class="pour-drawer-header">
      <h2>Pour Tracker</h2>
      <button class="pour-drawer-close" id="pourDrawerClose" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="pour-drawer-body">
      <% if (beers.length === 0) { %>
        <p class="pour-drawer-empty">No beers on tap.</p>
      <% } %>
      <% beers.filter(b => !b.is_coming_soon).forEach(beer => { %>
        <div class="drawer-card" data-beer-id="<%= beer.id %>">
          <div class="drawer-card-top">
            <span class="drawer-tap">#<%= beer.tap_number %></span>
            <div class="drawer-info">
              <strong class="drawer-name"><%= beer.name %></strong>
              <% if (beer.style) { %><span class="drawer-style"><%= beer.style %></span><% } %>
            </div>
            <% if (beer.pints_total > 0) { %>
              <span class="drawer-pints-count"><%= Math.round(beer.pints_remaining) %><small>/<%= beer.pints_total %></small></span>
            <% } %>
          </div>
          <% if (beer.pints_total > 0) { %>
            <div class="drawer-bar-wrap">
              <div class="drawer-bar">
                <div class="drawer-fill" style="width: <%= Math.round((beer.pints_remaining / beer.pints_total) * 100) %>%"></div>
              </div>
            </div>
          <% } %>
          <div class="drawer-actions">
            <button class="drawer-pour-btn" data-id="<%= beer.id %>" data-amount="0.33">⅓ Pint</button>
            <button class="drawer-pour-btn" data-id="<%= beer.id %>" data-amount="0.5">½ Pint</button>
            <button class="drawer-pour-btn drawer-pour-btn--primary" data-id="<%= beer.id %>" data-amount="1">Pint</button>
          </div>
        </div>
      <% }) %>
    </div>
  </aside>

  <script>
    // ---- Pint display helpers ----
    function updateBeerPints(beers) {
      beers.forEach(beer => {
        const pct = beer.pints_total > 0
          ? Math.round((beer.pints_remaining / beer.pints_total) * 100)
          : 0;

        // Main grid card
        const card = document.querySelector(`.tap-card[data-beer-id="${beer.id}"]`);
        if (card) {
          const fill = card.querySelector('.pints-fill');
          const count = card.querySelector('.pints-count');
          const indicator = card.querySelector('.pints-indicator');
          if (fill && beer.pints_total > 0) fill.style.width = pct + '%';
          if (count) count.textContent = Math.round(beer.pints_remaining) + ' pints';
          if (indicator) indicator.title = Math.round(beer.pints_remaining) + ' of ' + beer.pints_total + ' pints remaining';
          card.classList.toggle('is-empty', beer.pints_total > 0 && beer.pints_remaining <= 0);
        }

        // Drawer card
        const dCard = document.querySelector(`.drawer-card[data-beer-id="${beer.id}"]`);
        if (dCard) {
          const fill = dCard.querySelector('.drawer-fill');
          const count = dCard.querySelector('.drawer-pints-count');
          if (fill && beer.pints_total > 0) fill.style.width = pct + '%';
          if (count) count.innerHTML = Math.round(beer.pints_remaining) + '<small>/' + beer.pints_total + '</small>';
        }
      });
    }

    // ---- Live poll ----
    let knownCount = document.querySelectorAll('.tap-card').length;

    async function refreshBeers() {
      try {
        const res = await fetch('/api/beers');
        const beers = await res.json();
        if (beers.length !== knownCount) { location.reload(); return; }
        updateBeerPints(beers);
      } catch (e) {}
    }

    setInterval(refreshBeers, 5000);

    // ---- Fullscreen toggle ----
    const fullscreenBtn = document.getElementById('fullscreenBtn');
    fullscreenBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    });

    document.addEventListener('fullscreenchange', () => {
      document.body.classList.toggle('is-fullscreen', !!document.fullscreenElement);
    });

    // ---- Pour drawer ----
    const drawer = document.getElementById('pourDrawer');
    const overlay = document.getElementById('pourDrawerOverlay');
    const drawerToggleBtn = document.getElementById('pourDrawerBtn');
    const drawerCloseBtn = document.getElementById('pourDrawerClose');

    function openDrawer() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      drawerToggleBtn.classList.add('is-active');
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      drawerToggleBtn.classList.remove('is-active');
    }

    drawerToggleBtn.addEventListener('click', () => {
      drawer.classList.contains('is-open') ? closeDrawer() : openDrawer();
    });
    drawerCloseBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);

    // Close on Escape
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
    });

    // ---- Pour actions in drawer ----
    drawer.querySelectorAll('.drawer-pour-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const amount = parseFloat(btn.dataset.amount);
        const allBtns = btn.closest('.drawer-actions').querySelectorAll('.drawer-pour-btn');

        allBtns.forEach(b => b.disabled = true);

        try {
          const res = await fetch(`/api/beers/${id}/pour`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount }),
          });
          if (!res.ok) throw new Error();

          const data = await res.json();
          updateBeerPints([data]);

          const card = btn.closest('.drawer-card');
          card.classList.add('poured');
          setTimeout(() => card.classList.remove('poured'), 400);
        } catch {
          alert('Failed to record pour. Try again.');
        } finally {
          allBtns.forEach(b => b.disabled = false);
        }
      });
    });
  </script>
</body>
</html>
